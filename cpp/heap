// to make a maxheap use priority_queue

#include<iostream>
#include<queue>

using namespace std;
int main(){
  int n,k,l;
  cin>>n;
  priority_queue<int> maxheap;
  while(n--){
    cin>>k;
    maxheap.push(k);
  }
}

